# ============================================
# VARIAVEIS OBRIGATORIAS
# Estas variaveis DEVEM ser configuradas antes do deploy
# O backend NAO iniciara se estas variaveis nao estiverem definidas
# ============================================

# Banco de Dados PostgreSQL (OBRIGATORIO)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Seguranca - Chave secreta para tokens JWT (OBRIGATORIO)
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=sua_chave_secreta_muito_longa_e_aleatoria

# Senha inicial do usuario admin (OBRIGATORIO)
# Use uma senha forte! Sera usada apenas na primeira inicializacao
ADMIN_INICIAL_SENHA=SenhaForteParaAdminInicial123!

# ============================================
# VARIAVEIS OPCIONAIS
# ============================================

# E-mail (Resend) - para envio de emails
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=atendimento@vaucherealvares.com

# Google OAuth (opcional - para login com Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_ADMIN=https://seu-dominio.com/api/auth/google/callback
GOOGLE_REDIRECT_URI_CLIENTE=https://seu-dominio.com/api/cliente/auth/google/callback

# URLs dos frontends (para CORS) - geralmente configuradas no codigo
FRONTEND_CLIENTE_URL=https://cadastro.vaucherealvares.com
FRONTEND_ADMIN_URL=https://painel.vaucherealvares.com
